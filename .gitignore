# Secrets — must NEVER be committed. Use Infisical 'infra-bootstrap' project.
*.env
*.secret
secrets.yml
secrets.local.yml
.envrc

# Ansible
*.retry
.ansible/
roles/*/tests/
inventory/*/host_vars/*/vault

# Python
__pycache__/
*.pyc
.venv/
.python-version
.mypy_cache/
kubespray-venv/

# K8s
.kube/

# kubespray runtime artifacts (submodule owns these, but just in case)
kubespray/cluster.yml
kubespray/inventory/*.retry
kubespray/inventory/artifacts/
kubespray/.vagrant/

# Pigsty runtime
pigsty/dist/
pigsty/files/pg_id*

# Terraform / state
*.tfstate
*.tfstate.backup
.terraform/
*.tfvars
!*.tfvars.example

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*.swo
*~

# graphify
graphify-out/

# kubespray credentials_dir (= inventory/<name>/credentials) — ADR-0040.
# kubespray writes generated secrets here as *.creds via lookup('password', ...):
# kubeadm_certificate_key.creds today, kube_encrypt_token.creds once
# kube_encrypt_secret_data is enabled. The existing *.secret / host_vars vault
# rules miss this extension, which is how two of these ended up committed.
#
# NOTE: kube_encrypt_token.creds is NOT regenerable — losing it after Secrets
# have been rewritten makes every Secret in etcd undecryptable. It must be
# backed up to Infisical, not to git. See docs/secrets.md.
*.creds
