# Copy to terraform.tfvars and fill in — that file is gitignored (matches
# *.tfvars not being committed for anything with real values; only this
# .example file is tracked). No secrets belong here: PROXMOX_VE_API_TOKEN
# and PROXMOX_VE_SSH_PRIVATE_KEY come from Infisical via the `infisical run`
# wrapper in README.md, never from a file.

pve_node_name        = "" # confirm via `pvesh get /nodes` — likely "bnei" but not guaranteed identical to the DNS hostname
template_storage_id  = "" # PVE storage pool for the template + K8s VM disks, e.g. "local-lvm" or a ZFS pool — check `pvesm status`
# template_download_storage_id defaults to "local" — only override if that
# storage doesn't support content type "import" on your host (`pvesh get
# /storage`, look for "import" in the content list; LVM-thin pools never do)
garage_container_storage = "" # NVMe-backed pool for garage-storage's disk — check `pvesm status`
garage_ip             = "" # static IP for the recreated garage-storage container — none locked in MISSION.md yet, pick one and treat as provisional
# longhorn_disk_size_gb: fallback only, defaults to 50 (ADR-0019) — k8s_nodes
# entries in variables.tf already set their own per-node size; only override
# here if you want a different fallback for future entries that omit it.

# Only needed once .200/.161 have joined the PVE cluster (see
# docs/adr/0020-pve-corosync-cluster.md, docs/runbook-pve-postinstall.md):
# add worker-only entries to k8s_nodes here (setting this variable at all
# replaces the whole default map, so copy k8s-cp-01/k8s-worker-01 from
# variables.tf's default alongside any new entries). node_name/datastore_id
# come from live `pvesh get /nodes` / `pvesm status` on the new node, never
# guessed. Example shape for a worker on server1 (.200):
# k8s_nodes = {
#   "k8s-cp-01"     = { ... }  # copy unchanged from variables.tf default
#   "k8s-worker-01" = { ... }  # copy unchanged from variables.tf default
#   "k8s-worker-02" = {
#     vm_id                 = 203
#     ip                    = "192.168.1.203"
#     cpu_cores             = 4
#     memory_dedicated_mb   = 8192
#     os_disk_size_gb       = 60
#     longhorn_disk_size_gb = 60
#     control_plane         = false
#     etcd                  = false
#     worker                = true
#     gpu                   = false
#     node_name             = "" # confirm via `pvesh get /nodes` on server1
#     datastore_id          = "" # confirm via `pvesm status` on server1 (the ZFS pool from pve-postinstall.yml)
#   }
# }

# Only needed once imported.tf's placeholder variables are filled from live
# `qm config` / `pct config` capture (see imported.tf's header comment):
# pg01_disk_datastore_id        = ""
# pg01_network_bridge           = ""
# pg01_mac_address              = ""
# pg02_disk_datastore_id        = ""
# pg02_network_bridge           = ""
# pg02_mac_address              = ""
# hermesagent_disk_datastore_id = ""
# hermesagent_network_bridge    = ""
# hermesagent_mac_address       = ""
# hermesagent_unprivileged      = true
