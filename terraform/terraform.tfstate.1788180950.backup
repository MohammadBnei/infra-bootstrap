            "file_name": "k8s-vm-vendor-data.yaml",
            "file_size": null,
            "file_tag": null,
            "id": "local:snippets/k8s-vm-vendor-data.yaml",
            "node_name": "bnei",
            "overwrite": true,
            "source_file": [],
            "source_raw": [
              {
                "data": "#cloud-config\npackages:\n  - qemu-guest-agent\nruncmd:\n  - systemctl enable --now qemu-guest-agent\nbootcmd:\n  - |\n    if [ -b /dev/sdb ]; then\n      blkid /dev/sdb | grep -q TYPE= || mkfs.ext4 -L longhorn /dev/sdb\n      mkdir -p /var/lib/longhorn\n      grep -q \"/var/lib/longhorn\" /etc/fstab || \\\n        echo \"LABEL=longhorn /var/lib/longhorn ext4 defaults 0 2\" \u003e\u003e /etc/fstab\n      mount -a\n    fi\n",
                "file_name": "k8s-vm-vendor-data.yaml",
                "resize": 0
              }
            ],
            "timeout_upload": 1800,
            "upload_mode": "stream"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
        }
      ]
    },
